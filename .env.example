# Copy to .env.local and replace with the same private key used by UTM Ops.
UTM_MONITORING_TOKEN=replace-with-a-random-shared-key
VITE_OPS_WS_URL=ws://localhost:8000/ws/flight-plans
# Example simulator on a separate port; change to the actual telemetry source.
VITE_WS_TELEMETRY_URL=ws://localhost:8001/ws/telemetry
